{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    },
    {
      "name": "Next.js: debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "NODE_OPTIONS='--inspect' npm run dev"
    },
    {
      "name": "Next.js: debug client-side (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8910",
      "webRoot": "${workspaceFolder}/src"
    },
    {
      "name": "Vitest: run all tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm test"
    },
    {
      "name": "Vitest: watch",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run test:watch"
    }
  ],
  "compounds": [
    {
      "name": "Next.js: full stack debug",
      "configurations": [
        "Next.js: debug server-side",
        "Next.js: debug client-side (Chrome)"
      ],
      "stopAll": true
    }
  ]
}
